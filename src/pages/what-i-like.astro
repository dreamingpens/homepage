---
import { getCollection } from "astro:content";
import BulletList from "../components/BulletList.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const [profileEntry] = await getCollection("profile");
const [likesEntry] = await getCollection("likes");
if (!profileEntry || !likesEntry) {
  throw new Error("Profile and What I like content are required.");
}
const profile = profileEntry.data;
const likes = likesEntry.data;
---

<SiteLayout profile={profile} title={`${likes.heading} — ${profile.name}`} activePage="what-i-like">
  <section class="section page-section" id="what-i-like" aria-labelledby="what-i-like-title">
    <div class="section-label">
      <h1 id="what-i-like-title">{likes.heading}</h1>
    </div>

    {likes.bullets.length > 0 && (
      <BulletList items={likes.bullets} class="section-content principle-list" />
    )}
  </section>
</SiteLayout>
