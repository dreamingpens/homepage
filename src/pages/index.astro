---
import { getCollection } from "astro:content";
import BulletList from "../components/BulletList.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../utils/urls";

const [profileEntry] = await getCollection("profile");
const [dreamEntry] = await getCollection("dream");
const [philosophyEntry] = await getCollection("philosophy");
const [beliefsEntry] = await getCollection("beliefs");
const [whoamiEntry] = await getCollection("whoami");

if (!profileEntry || !dreamEntry || !philosophyEntry || !beliefsEntry) {
  throw new Error("Profile, dream, philosophy, and beliefs content are required.");
}

const profile = profileEntry.data;
const dream = dreamEntry.data;
const philosophy = philosophyEntry.data;
const beliefs = beliefsEntry.data;
if (!whoamiEntry) {
  throw new Error("Who am I content is required in src/data/whoami.yaml.");
}
const whoami = whoamiEntry.data;
const profileLinks = (await getCollection("links")).sort(
  (a, b) => a.data.order - b.data.order,
);

---

<SiteLayout profile={profile}>
  <section class="hero" id="top" aria-label="Profile">
    <p class="eyebrow">{profile.eyebrow}</p>

    <div class="hero-footer">
      <p class="introduction">
        {profile.introduction.affiliation}, where I work under the supervision of{" "}
        <a href={profile.introduction.supervisor.url}>
          {profile.introduction.supervisor.name}
        </a>. {profile.introduction.research}
      </p>

      <ul class="profile-links" aria-label="Profile links">
        {
          profileLinks.map((link) => (
            <li>
              <a
                href={
                  link.id === "email"
                    ? `mailto:${profile.email}`
                    : withBase(link.data.url ?? "#")
                }
              >
                {link.data.label}
                {link.data.show_arrow && <span aria-hidden="true"> ↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="dream" aria-labelledby="dream-title">
    <div class="section-label">
      <h2 id="dream-title">{dream.heading}</h2>
    </div>

    {dream.paragraphs.length > 0 && (
      <ul class="section-content dream-copy">
        {dream.paragraphs.map((paragraph) => <li>{paragraph}</li>)}
      </ul>
    )}
  </section>

  <section
    class="section philosophy"
    id="philosophy"
    aria-labelledby="philosophy-title"
  >
    <div class="section-label">
      <h2 id="philosophy-title">{philosophy.heading}</h2>
    </div>

    <div class="section-content philosophy-copy">
      <ul class="principle-list">
        {
          philosophy.principles.map((principle) => (
            <li class:list={{ "expandable-bullet": principle.body.length > 0 }}>
              {principle.body.length > 0 ? (
                <details>
                  <summary><strong>{principle.title}</strong></summary>
                  <BulletList items={principle.body} />
                </details>
              ) : (
                <strong>{principle.title}</strong>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section class="section" id="beliefs" aria-labelledby="beliefs-title">
    <div class="section-label">
      <h2 id="beliefs-title">{beliefs.heading}</h2>
    </div>

    {beliefs.paragraphs.length > 0 && (
      <ul class="section-content beliefs-copy">
        {beliefs.paragraphs.map((paragraph) => (
          <li>
            {paragraph.url ? (
              <a href={paragraph.url}>{paragraph.text}</a>
            ) : paragraph.text}
          </li>
        ))}
      </ul>
    )}
  </section>
  <section class="section" id="who-am-i" aria-labelledby="who-am-i-title">
    <div class="section-label">
      <h2 id="who-am-i-title">{whoami.heading}</h2>
    </div>

    {whoami.bullets.length > 0 && (
      <BulletList items={whoami.bullets} class="section-content principle-list whoami-copy" />
    )}
  </section>
</SiteLayout>
