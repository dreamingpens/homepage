---
import { getCollection } from "astro:content";
import "../styles/global.css";

const [profileEntry] = await getCollection("profile");
const [philosophyEntry] = await getCollection("philosophy");

if (!profileEntry || !philosophyEntry) {
  throw new Error("Profile and philosophy content are required.");
}

const profile = profileEntry.data;
const philosophy = philosophyEntry.data;
const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year,
);
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.year - a.data.year,
);
const profileLinks = (await getCollection("links")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#f4f1e8" />
    <title>{profile.page_title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label={`${profile.name}, back to top`}>
        <span>{profile.name}</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#philosophy">{profile.navigation.philosophy}</a>
        <a href="#publications">{profile.navigation.publications}</a>
        <a href="#projects">{profile.navigation.projects}</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <p class="eyebrow">{profile.eyebrow}</p>
        <h1 id="hero-title">{profile.headline}</h1>

        <div class="hero-footer">
          <p class="introduction">{profile.introduction}</p>

          <ul class="profile-links" aria-label="Profile links">
            {
              profileLinks.map((link) => (
                <li>
                  <a href={link.data.url}>
                    {link.data.label}
                    {link.data.show_arrow && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section
        class="section philosophy"
        id="philosophy"
        aria-labelledby="philosophy-title"
      >
        <div class="section-label">
          <h2 id="philosophy-title">{philosophy.heading}</h2>
        </div>

        <div class="section-content philosophy-copy">
          <p class="lead">{philosophy.lead}</p>
          <p>{philosophy.body}</p>
        </div>
      </section>

      <section class="section" id="publications" aria-labelledby="publications-title">
        <div class="section-label">
          <h2 id="publications-title">{profile.publications_heading}</h2>
        </div>

        <ol class="section-content publication-list">
          {
            publications.map((publication) => (
              <li>
                <article>
                  <p class="publication-year">{publication.data.year}</p>
                  <div>
                    <h3>
                      <a href={publication.data.url}>{publication.data.title}</a>
                    </h3>
                    <p>
                      {publication.data.authors.map((author, index) => (
                        <>
                          {author.highlight ? <strong>{author.name}</strong> : author.name}
                          {index < publication.data.authors.length - 1 && ", "}
                        </>
                      ))}
                    </p>
                    <p class="publication-venue">
                      {publication.data.venue}
                      {publication.data.links.map((link) => (
                        <>
                          {" · "}<a href={link.url}>{link.label}</a>
                        </>
                      ))}
                    </p>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section" id="projects" aria-labelledby="projects-title">
        <div class="section-label">
          <h2 id="projects-title">{profile.projects_heading}</h2>
        </div>

        <div class="section-content project-list">
          {
            projects.map((project) => (
              <article>
                <div>
                  <h3><a href={project.data.url}>{project.data.title}</a></h3>
                  <p>{project.data.description}</p>
                  <p class="project-meta">
                    {[...project.data.meta, String(project.data.year)].join(" · ")}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <p>{profile.footer_message}</p>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <p class="footer-note">© {profile.copyright_year} {profile.name}</p>
    </footer>
  </body>
</html>
